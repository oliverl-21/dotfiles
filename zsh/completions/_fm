#compdef fm
local context state state_descr line
_fm_commandname=$words[1]
typeset -A opt_args

_fm() {
    integer ret=1
    local -a args
    args+=(
        '(-h --help)'{-h,--help}'[Show help information.]'
        '(-): :->command'
        '(-)*:: :->arg'
    )
    _arguments -w -s -S $args[@] && ret=0
    case $state in
        (command)
            local subcommands
            subcommands=(
                'respond:Generate a response to a prompt.'
                'chat:Start an interactive chat session.'
                'count-tokens:Count the tokens in a prompt, instructions, or transcript.'
                'schema:Generate a structured output generation schema.'
                'serve:Start a Chat Completions API server for Foundation Models.'
                'models:Check model availability.'
                'quota-usage:Check model quota usage.'
                'license:Show and agree to the Foundation Models CLI Legal Notice & Terms.'
                'config:View and edit the CLI configuration.'
                'help:Show subcommand help information.'
            )
            _describe "subcommand" subcommands
            ;;
        (arg)
            case ${words[1]} in
                (respond)
                    _fm_respond
                    ;;
                (chat)
                    _fm_chat
                    ;;
                (count-tokens)
                    _fm_count-tokens
                    ;;
                (schema)
                    _fm_schema
                    ;;
                (serve)
                    _fm_serve
                    ;;
                (models)
                    _fm_models
                    ;;
                (quota-usage)
                    _fm_quota-usage
                    ;;
                (license)
                    _fm_license
                    ;;
                (config)
                    _fm_config
                    ;;
                (help)
                    _fm_help
                    ;;
            esac
            ;;
    esac

    return ret
}

_fm_respond() {
    integer ret=1
    local -a args
    args+=(
        '--stream[Stream the output as it'"'"'s generated]'
        '--no-stream[Stream the output as it'"'"'s generated]'
        '(--greedy -g)'{--greedy,-g}'[Use greedy sampling]'
        '(--model -m)'{--model,-m}'[Model to use: system, pcc, or a model served by --model-provider]:model:'
        '--model-provider[Chat Completions model provider: a configured name or a base URL (e.g. http://host:port/v1)]:model-provider:'
        '*--model-provider-header[Extra request header for --model-provider, as '"'"'Name: Value'"'"' (repeatable)]:model-provider-header:'
        '--use-case[Use case for the language model]:use-case:'
        '--guardrails[Guardrail level for the language model]:guardrails:'
        '(--verbose -v)'{--verbose,-v}'[Print verbose output]'
        '(--instructions -i)'{--instructions,-i}'[Instructions for the model to follow]:instructions:'
        '--schema[A path to a schema file, or an inline schema string]:schema:_files -g '"'"'*.json'"'"''
        ':prompt:'
        '*--text[Text segment to include in the prompt]:text:'
        '*--image[Path to an image to include in the prompt]:image:_files'
        '*--label[Label for the corresponding --image (repeatable, paired by order). Requires --tool. Defaults to '"'"'image_<index>'"'"'.]:label:'
        '*--tool[Built-in tool to enable (repeatable). Known: barcode, ocr.]:tool:'
        '--save-transcript[Save the transcript to a file after responding. An absolute path is used as-is; a bare filename is saved in the current directory.]:save-transcript:_files -g '"'"'*.json'"'"''
        '--resume[Continue an earlier conversation: load a saved transcript so the model picks up with its previous turns as context]:resume:_files -g '"'"'*.json'"'"''
        '(-h --help)'{-h,--help}'[Show help information.]'
    )
    _arguments -w -s -S $args[@] && ret=0

    return ret
}

_fm_chat() {
    integer ret=1
    local -a args
    args+=(
        '(--model -m)'{--model,-m}'[Model to use: system, pcc, or a model served by --model-provider]:model:'
        '--model-provider[Chat Completions model provider: a configured name or a base URL (e.g. http://host:port/v1)]:model-provider:'
        '*--model-provider-header[Extra request header for --model-provider, as '"'"'Name: Value'"'"' (repeatable)]:model-provider-header:'
        '--use-case[Use case for the language model]:use-case:'
        '--guardrails[Guardrail level for the language model]:guardrails:'
        '(--resume -r)'{--resume,-r}'[Resume a saved chat session]:resume:'
        '--continue[Continue the most recent chat session]'
        '(--instructions -i)'{--instructions,-i}'[Instructions for the model]:instructions:'
        '*--tool[Built-in tool to enable (repeatable). Known: barcode, ocr.]:tool:'
        '--set-default-model[Persist <model> as the default for future fm chat sessions]:set-default-model:(system pcc)'
        '--set-ax-screen-reader'
        '--set-no-ax-screen-reader'
        '--ax-screen-reader[Render output for a screen reader: plain lines, no animation or cursor redrawing]'
        '--no-ax-screen-reader[Render output for a screen reader: plain lines, no animation or cursor redrawing]'
        '--set-ax-bell[Persist whether screen reader mode rings the bell when a slow turn finishes]:set-ax-bell:'
        '(-h --help)'{-h,--help}'[Show help information.]'
    )
    _arguments -w -s -S $args[@] && ret=0

    return ret
}

