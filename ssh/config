###########################################
# Load Hosts folder
##########################################

include hosts/*.conf

#########################################
# General Config
##########################################

HashKnownHosts yes
Compression yes
TCPKeepAlive yes
StrictHostKeyChecking accept-new
VisualHostKey no
UpdateHostKeys yes
IgnoreUnknown useKeychain
# Legacy crypto (SHA1 KEX, ssh-rsa, CBC) lives in hosts/legacy.conf, scoped per host

##########################################
# Default System
##########################################

Host *
    useKeychain yes
    AddKeysToAgent yes
    ServerAliveInterval 120
    ServerAliveCountMax 2
